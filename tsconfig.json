{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "declaration": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@superagent/kernel": [
        "./packages/kernel/src/index.ts"
      ],
      "@superagent/dsh": [
        "./packages/dsh/src/index.ts"
      ],
      "@superagent/dsh/github-watch": [
        "./packages/dsh/src/sources/github.ts"
      ],
      "@superagent/dsh/feishu-watch": [
        "./packages/dsh/src/sources/feishu.ts"
      ],
      "@superagent/dsh/*": [
        "./packages/dsh/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "lib",
    "packages/*/lib"
  ],
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "meta/**/*.ts",
    "tsdown.config.ts"
  ]
}
